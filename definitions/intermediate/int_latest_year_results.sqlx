config {
    type: "view",
    description: "Development data filtered to only include rows from the latest available year's data pulls",
}

SELECT id, opendata_id, pipeline_status, application_number, date_received, 
       `description`, `address`, ward, proposed_residential_gross_floor_area,
       proposed_non_residential_gross_floor_area, proposed_gross_floor_area,
       proposed_residential_units, application_information_centre_link,
       `quarter`, `year`
FROM ${ref("development_pipeline")}
WHERE year = (SELECT MAX(year) FROM ${ref("development_pipeline")})